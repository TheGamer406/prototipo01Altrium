# Copiar a .env y cambiar las contraseñas. .env nunca se sube.

# Acceso al demo (basic auth de nginx en 5471 y 5472)
DEMO_USER=cipreses
DEMO_PASSWORD=cambiar_esto

# Base de datos
POSTGRES_DB=acompana
POSTGRES_USER=acompana
POSTGRES_PASSWORD=cambiar_esto

# pgAdmin (5473 usa su propio login)
PGADMIN_DEFAULT_EMAIL=admin@acompana.local
PGADMIN_DEFAULT_PASSWORD=cambiar_esto

# Aplicación
TZ=America/Costa_Rica
DEMO_SEED=2026
PROVIDER_ACCEPT_TIMEOUT_MIN=30
TRANSFER_THRESHOLD_MIN=20
